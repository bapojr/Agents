# Local development only. Run python3 scripts/init_env.py to generate private .env values.
POSTGRES_PASSWORD=
DATABASE_URL=
RESEARCH_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
RESEARCH_REDIS_URL=redis://localhost:6379/0
RESEARCH_INTERNAL_TOKEN=
AUTH_SECRET=
APP_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
TRUST_PROXY=false

# Live documents and AI extraction (server only; never NEXT_PUBLIC).
RESEARCH_SERVICE_URL=http://127.0.0.1:8000
RESEARCH_OPENAI_API_KEY=
RESEARCH_EXTRACTION_MODEL=
RESEARCH_OPENALEX_API_KEY=
# Exact UI origin allowed by an externally hosted authenticated Next.js BFF.
PAGES_ORIGIN=https://bapojr.github.io
# Public URL only, no tokens; leave empty until the hosted authenticated backend is ready.
NEXT_PUBLIC_RESEARCH_API_URL=
