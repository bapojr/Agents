FROM python:3.12-slim
WORKDIR /app
COPY services/research services/research
RUN pip install --no-cache-dir -r services/research/requirements.lock && pip install --no-deps ./services/research
RUN useradd --create-home app
USER app
EXPOSE 8000
# One worker owns the bounded document cache and processing budget. No database or AI keys.
CMD ["sh", "-c", "exec uvicorn agents_research.document_app:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --limit-concurrency 16 --no-proxy-headers"]
